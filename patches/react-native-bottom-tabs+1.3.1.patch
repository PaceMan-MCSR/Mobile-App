@@ -136,10 +136,44 @@ struct TabViewImpl: View {
 
     if props.scrollEdgeAppearance == "transparent" {
       configureTransparentAppearance(tabBar: tabBar, props: props)
+      applySelectedSymbolImages(props: props, tabBar: tabBar)
       return
     }
 
     configureStandardAppearance(tabBar: tabBar, props: props)
+    applySelectedSymbolImages(props: props, tabBar: tabBar)
+  }
+
+  // Sets a distinct `image` (unfocused) and `selectedImage` (focused) on each SF Symbol
+  // tab so iOS can morph between the two variants when the selection moves (Liquid Glass
+  // cross-fade on iOS 26). Mirrors the experimental baked-tint pass, including the async
+  // re-apply, since SwiftUI repopulates the item image after building the bar.
+  private func applySelectedSymbolImages(props: TabViewProps, tabBar: UITabBar) {
+    // The experimental baked-tint path renders its own item images; don't fight it.
+    if shouldUseExperimentalBakedTintColors(props: props) { return }
+
+    applySymbolImagesIfNeeded(props: props, tabBar: tabBar)
+
+    DispatchQueue.main.async { [weak tabBar] in
+      guard let tabBar else { return }
+      applySymbolImagesIfNeeded(props: props, tabBar: tabBar)
+    }
+  }
+
+  private func applySymbolImagesIfNeeded(props: TabViewProps, tabBar: UITabBar) {
+    guard let items = tabBar.items else { return }
+
+    for (tabBarIndex, item) in items.enumerated() {
+      guard let tabData = props.filteredItems[safe: tabBarIndex],
+        !tabData.sfSymbol.isEmpty
+      else { continue }
+
+      let selectedName =
+        tabData.selectedSfSymbol.isEmpty ? tabData.sfSymbol : tabData.selectedSfSymbol
+
+      item.image = UIImage(systemName: tabData.sfSymbol)
+      item.selectedImage = UIImage(systemName: selectedName)
+    }
   }
 #endif
 
